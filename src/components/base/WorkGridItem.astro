---
/** One tile in the work grid: full-bleed thumbnail with the project name
 *  and sector tags overlaid at the foot, always visible, and the same
 *  pulsing glow as the sprint cards behind it on hover. Links straight
 *  to the case study. */
import GlowWrap from "@/components/base/GlowWrap.astro";
import type { WorkItem } from "@/data/work.ts";

type Props = WorkItem & {
  /** Set to `false` to skip rendering this component. */
  render?: boolean;
};

const { render = true, slug, name, tags, thumbnail } = Astro.props;
---

{
  render && slug && (
    <GlowWrap class="work-grid-item_glow_wrap">
      <a class="work-grid-item_wrap" href={`/work/${slug}`}>
        <img
          class="work-grid-item_img"
          src={thumbnail.src}
          alt={thumbnail.alt}
          srcset={thumbnail.srcset}
          sizes={thumbnail.sizes}
          loading="lazy"
        />
        <span class="work-grid-item_scrim" aria-hidden="true" />
        <span class="work-grid-item_content">
          <span class="work-grid-item_name">{name}</span>
          <span class="work-grid-item_tags">
            {tags.join(", ").toUpperCase()}
          </span>
        </span>
      </a>
    </GlowWrap>
  )
}

<style is:global>
  @layer components {
    .work-grid-item_wrap {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  min-height: 16rem;
  overflow: hidden;
  border-radius: var(--radius-small);
  background-color: var(--dark-900);
  text-decoration: none;
}

    .work-grid-item_img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .work-grid-item_scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--dark-900) 85%, transparent) 0%,
        transparent 45%
      );
      pointer-events: none;
    }

    .work-grid-item_content {
      position: absolute;
      inset: auto var(--space-5) var(--space-5) var(--space-5);
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-4);
      font-family: var(--secondary-family);
      font-size: var(--text-small);
      line-height: var(--line-height-large);
      color: var(--light-100);
    }

    .work-grid-item_name {
      font-family: var(--primary-family);
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .work-grid-item_tags {
      letter-spacing: 0.05em;
      text-align: right;
    }

    @media (hover: hover) {
      .work-grid-item_wrap:hover .work-grid-item_img {
        transform: scale(1.04);
      }
    }
  }
</style>
