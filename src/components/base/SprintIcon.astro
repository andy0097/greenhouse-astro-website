---
/** One of the small line icons used on the Website Sprint page — pricing
 *  tiers and week-by-week steps. Inline so no icon asset import is needed;
 *  stroke follows currentColor per the Lumos SVG convention. */
type SprintIconName = "calendar" | "rocket" | "compass" | "layers" | "code" | "heart";

interface Props {
  name: SprintIconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={["sprint-icon", className]}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  {
    name === "calendar" && (
      <>
        <rect x="3.5" y="4.5" width="17" height="16" rx="2" class="sprint-icon_shape" />
        <line x1="3.5" y1="9.5" x2="20.5" y2="9.5" class="sprint-icon_shape" />
        <line x1="8" y1="2.5" x2="8" y2="6.5" class="sprint-icon_shape" />
        <line x1="16" y1="2.5" x2="16" y2="6.5" class="sprint-icon_shape" />
      </>
    )
  }
  {
    name === "rocket" && (
      <>
        <path
          d="M12 2.5c2.8 1.7 4.5 4.7 4.5 8.5 0 2-.6 3.7-1.5 5l-3-1-3 1c-.9-1.3-1.5-3-1.5-5 0-3.8 1.7-6.8 4.5-8.5Z"
          class="sprint-icon_shape"
        />
        <circle cx="12" cy="10" r="1.5" class="sprint-icon_shape" />
        <path d="M9 15.5 7 20l3-1.5" class="sprint-icon_shape" />
        <path d="M15 15.5 17 20l-3-1.5" class="sprint-icon_shape" />
      </>
    )
  }
  {
    name === "compass" && (
      <>
        <circle cx="12" cy="12" r="9" class="sprint-icon_shape" />
        <path d="m14.5 9.5-2 5-5 2 2-5 5-2Z" class="sprint-icon_shape" />
      </>
    )
  }
  {
    name === "layers" && (
      <>
        <path d="m12 3 8.5 4.5L12 12 3.5 7.5 12 3Z" class="sprint-icon_shape" />
        <path d="m3.5 12 8.5 4.5 8.5-4.5" class="sprint-icon_shape" />
        <path d="m3.5 16.5 8.5 4.5 8.5-4.5" class="sprint-icon_shape" />
      </>
    )
  }
  {
    name === "code" && (
      <>
        <path d="m8.5 8-4.5 4 4.5 4" class="sprint-icon_shape" />
        <path d="m15.5 8 4.5 4-4.5 4" class="sprint-icon_shape" />
        <line x1="13.5" y1="5.5" x2="10.5" y2="18.5" class="sprint-icon_shape" />
      </>
    )
  }
  {
    name === "heart" && (
      <path
        d="M12 20.5s-7.5-4.6-9.7-9.2C.7 8 2.4 4.5 6 4c2.1-.3 4 .8 6 3 2-2.2 3.9-3.3 6-3 3.6.5 5.3 4 3.7 7.3-2.2 4.6-9.7 9.2-9.7 9.2Z"
        class="sprint-icon_shape"
      />
    )
  }
</svg>

<style is:global>
  @layer components {
    .sprint-icon {
      flex: none;
      width: 1.5rem;
      height: 1.5rem;
    }

    .sprint-icon_shape {
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.3;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  }
</style>
