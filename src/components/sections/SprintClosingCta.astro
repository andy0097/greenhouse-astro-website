---
/** The closing ask: one client at a time, one CTA. The page's single
 *  green-accent band, per the one-accent-per-page rule. */
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";

interface Props {
  /** Set to `false` to skip rendering this component. */
  render?: boolean;
  headline: string;
  body: string;
  cta: { label: string; href: string };
}

const { render = true, headline, body, cta } = Astro.props;
---

<Section render={render} theme="light" class="sprint-closing_wrap" align="center">
  <Heading
    tag="h2"
    variant="h2"
    class="sprint-closing_title"
    maxWidth={22}
    data-text-reveal
  >
    {headline}
  </Heading>
  <Paragraph variant="large" class="sprint-closing_body" maxWidth={40}>
    {body}
  </Paragraph>
  <ButtonWrapper marginTop="6">
    <Button element="link" href={cta.href} class="shine">
      {cta.label}
    </Button>
  </ButtonWrapper>
</Section>

<style is:global>
  @layer components {
    .sprint-closing_wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      text-align: center;
    }

    .sprint-closing_title {
      align-self: center;
    }

    .sprint-closing_body {
      color: var(--text-muted);
    }
  }
</style>
