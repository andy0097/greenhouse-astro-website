---
/** Frequently asked questions, as a native accordion — no client JS. */
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import type { FaqItem } from "@/data/websiteSprint.ts";

interface Props {
  /** Set to `false` to skip rendering this component. */
  render?: boolean;
  headline: string;
  items: FaqItem[];
}

const { render = true, headline, items } = Astro.props;
---

<Section render={render && items.length > 0} theme="light" class="faq_wrap">
  <div class="faq_header" data-reveal>
    <Heading tag="h2" variant="h2" class="faq_title" data-text-reveal>
      {headline}
    </Heading>
  </div>

  <ul class="faq_list" role="list" data-reveal data-stagger="true">
    {
      items.map((item) => (
        <li class="faq_item">
          <details class="faq_details">
            <summary class="faq_question">
              <span class="text-style-h6">{item.question}</span>
              <svg class="faq_chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="m4 6 4 4 4-4"
                  stroke="currentcolor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <Paragraph variant="main" class="faq_answer">
              {item.answer}
            </Paragraph>
          </details>
        </li>
      ))
    }
  </ul>
</Section>

<style is:global>
  @layer components {
    .faq_header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      width: 100%;
      text-align: center;
    }

    .faq_list {
      display: flex;
      flex-direction: column;
      width: 80%;
      margin: 0;
      margin-inline: auto;
      margin-top: var(--space-8);
      padding: 0;
      list-style: none;
    }

    .faq_item {
      border-top: var(--border-width) solid var(--border);

      &:last-child {
        border-bottom: var(--border-width) solid var(--border);
      }
    }

    .faq_details {
      padding-block: var(--space-5);

      &[open] .faq_chevron {
        transform: rotate(180deg);
      }
    }

    .faq_question {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      cursor: pointer;
      list-style: none;
      color: var(--text);

      &::-webkit-details-marker {
        display: none;
      }
    }

    .faq_chevron {
      flex: none;
      width: 1rem;
      height: 1rem;
      color: var(--text-muted);
      transition: transform 200ms;
    }

    .faq_answer {
      margin-top: var(--space-3);
      color: var(--text-muted);
    }
  }
</style>
