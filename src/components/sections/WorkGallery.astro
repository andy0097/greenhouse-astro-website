---
/** "More designs" under the case studies on /work: the same showcase grid
 *  as the Website/Brand Sprint audience sections (tall lead tile, two
 *  staggered columns, no links or hover interaction) — just a wall of
 *  proof, not navigation. */
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Video from "@/components/Video.astro";
import type { AudienceMedia } from "@/components/sections/SprintAudience.astro";

interface Props {
  /** Set to `false` to skip rendering this component. */
  render?: boolean;
  /** Hidden visually when empty; the section still gets an accessible name. */
  title?: string;
  images: AudienceMedia[];
}

const { render = true, title, images } = Astro.props;

/* Two independent columns rather than one synced grid, so the left
   column's taller lead tile can stagger the right column down by a flat
   32px instead of both columns sharing row heights — matches the Sprint
   audience grids. */
const leftItems = images.filter((_, index) => index % 2 === 0);
const rightItems = images.filter((_, index) => index % 2 === 1);
---

<Section
  render={render && images.length > 0}
  theme="dark"
  paddingTop="small"
  class="work-gallery_wrap"
  containerClass="work-gallery_container"
>
  <Heading
    tag="h2"
    variant="h2"
    class={title ? "work-gallery_title" : "work-gallery_title sr-only"}
    data-reveal
  >
    {title || "More designs"}
  </Heading>

  <div class="work-gallery_grid" data-reveal data-stagger="true">
    <div class="work-gallery_column">
      {
        leftItems.map((item, index) => (
          <div class:list={["work-gallery_tile", index === 0 && "is-tall"]}>
            {item.kind === "video" ? (
              <Video
                class="work-gallery_video"
                src={item.src}
                variant="custom"
                ratio="1 / 1"
                loop
                autoplay
                muted
              />
            ) : (
              <img
                class="work-gallery_img"
                src={item.src}
                alt={item.alt ?? ""}
                loading="lazy"
              />
            )}
          </div>
        ))
      }
    </div>
    <div class="work-gallery_column">
      {
        rightItems.map((item) => (
          <div class="work-gallery_tile">
            {item.kind === "video" ? (
              <Video
                class="work-gallery_video"
                src={item.src}
                variant="custom"
                ratio="1 / 1"
                loop
                autoplay
                muted
              />
            ) : (
              <img
                class="work-gallery_img"
                src={item.src}
                alt={item.alt ?? ""}
                loading="lazy"
              />
            )}
          </div>
        ))
      }
    </div>
  </div>
</Section>

<style is:global>
  @layer components {
    /* No shared `.section` grain here, matching the case studies above. */
    .work-gallery_wrap::after {
      content: none;
    }

    .work-gallery_grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
      width: 100%;
    }

    .work-gallery_column {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    /* Non-interactive showcase tile: no link, no hover state. */
    .work-gallery_tile {
  position: relative;
  display: block;
  overflow: hidden;
  border-radius: var(--radius-small);
  background-color: var(--background-2);
  pointer-events: none;
  &::before {
    content: "";
    display: block;
    padding-bottom: 100%;
  }
  &.is-tall::before {
    padding-bottom: calc(100% + 2rem);
  }
}

    .work-gallery_img,
    .work-gallery_video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
