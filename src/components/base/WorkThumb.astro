---
/** A row on the work index: full-bleed mockup, name, sector chips. */
import Heading from "@/components/Heading.astro";
import Tag from "@/components/base/Tag.astro";
import type { WorkItem } from "@/data/work.ts";

type Props = WorkItem & {
  /** Set to `false` to skip rendering this component. */
  render?: boolean;
};

const { render = true, slug, name, tags, thumbnail } = Astro.props;
---

{
  render && slug && (
    <a class="work-thumb_wrap" href={`/work/${slug}`} data-reveal>
      <span class="work-thumb_media">
        <img
          class="work-thumb_img"
          src={thumbnail.src}
          alt={thumbnail.alt}
          srcset={thumbnail.srcset}
          sizes={thumbnail.sizes}
          loading="lazy"
        />
      </span>
      <span class="work-thumb_content">
        <Heading tag="h2" variant="h2" class="work-thumb_title">
          {name}
        </Heading>
        <span class="work-thumb_tags">
          {tags.map((tag) => (
            <Tag>{tag}</Tag>
          ))}
        </span>
      </span>
    </a>
  )
}

<style is:global>
  @layer components {
    .work-thumb_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      text-decoration: none;
      color: inherit;
    }

    .work-thumb_media {
      display: block;
      overflow: hidden;
      border-radius: var(--radius-main);
      background-color: var(--background-2);
    }

    .work-thumb_img {
      width: 100%;
      transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);

      @media (hover: hover) {
        .work-thumb_wrap:hover & {
          transform: scale(1.02);
        }
      }
    }

    .work-thumb_content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);

      @media (width >= 48rem) {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
    }

    .work-thumb_tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
  }
</style>
