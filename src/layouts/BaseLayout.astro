---
import "@/styles/global.css";
import BaseHead from "@/components/BaseHead.astro";
import Analytics from "@/components/Analytics.astro";
import SkipLink from "@/components/SkipLink.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import CookieConsent from "@/components/CookieConsent.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
};

const { theme = "inherit", overlap = false, ...seo } = Astro.props;

// Fetched once per request by src/middleware.ts.
const { siteSettings, homepage } = Astro.locals;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
    <Analytics
      calendarUrls={[
        siteSettings.discoveryCallUrl,
        siteSettings.workshopCallUrl,
        siteSettings.navCtaUrl,
        siteSettings.closingCta?.primaryCta?.href,
      ]}
    />
  </head>
  <body>
    <SkipLink />
    <Nav overlap={overlap} navLinks={siteSettings.navLinks} navCtaUrl={siteSettings.navCtaUrl} />
    {
      /* `tabindex` so the jump moves focus here, not just the scroll position */
    }
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer
      footerLinks={siteSettings.footerLinks}
      footerLegalLinks={siteSettings.footerLegalLinks}
      footerSocialLinks={siteSettings.footerSocialLinks}
      founder={siteSettings.founder}
      closingCta={siteSettings.closingCta}
      contactEmail={siteSettings.contactEmail}
      discoveryCallUrl={siteSettings.discoveryCallUrl}
      splineScene={homepage.hero.splineScene}
      servicesIntro={homepage.servicesIntro}
    />
    <CookieConsent />
  </body>
</html>
