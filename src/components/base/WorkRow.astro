---
/** A project on the work index: name, summary and service chips on the
 *  left, the mockup full-bleed on the right. The whole row links to the
 *  case study. */
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Tag from "@/components/base/Tag.astro";
import type { WorkItem } from "@/data/work.ts";

type Props = WorkItem & {
  /** Set to `false` to skip rendering this component. */
  render?: boolean;
};

const { render = true, slug, name, summary, services, thumbnail } = Astro.props;
---

{
  render && slug && (
    <a class="work-row_wrap" href={`/work/${slug}`} data-reveal>
      <span class="work-row_content">
        <Heading tag="h2" variant="h2" class="work-row_title">
          {name}
        </Heading>
        <Paragraph tag="span" variant="main" class="work-row_text" maxWidth={48}>
          {summary}
        </Paragraph>
        {services.length > 0 && (
          <span class="work-row_tags">
            {services.map((service) => (
              <Tag>{service}</Tag>
            ))}
          </span>
        )}
      </span>
      <span class="work-row_media">
        <img
          class="work-row_img"
          src={thumbnail.src}
          alt={thumbnail.alt}
          srcset={thumbnail.srcset}
          sizes="(min-width: 64rem) 58vw, 100vw"
          loading="lazy"
        />
      </span>
    </a>
  )
}

<style is:global>
  @layer components {
    .work-row_wrap {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  overflow: hidden;
  border: var(--border-width) solid var(--border);
  border-radius: var(--radius-small);
  text-decoration: none;
  color: inherit;
  @media (width >= 48rem) {
    grid-template-columns: 5fr 7fr;
  }
}

    .work-row_content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      padding: var(--space-5);
    }

    .work-row_text {
      display: block;
      color: var(--text-muted);
    }

    .work-row_tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: auto;
      padding-top: var(--space-4);
    }

    .work-row_media {
      display: block;
      overflow: hidden;
      aspect-ratio: 16 / 10;
      background-color: var(--background-2);
    }

    .work-row_img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);

      @media (hover: hover) {
        .work-row_wrap:hover & {
          transform: scale(1.02);
        }
      }
    }
  }
</style>
