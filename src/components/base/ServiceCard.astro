---
/** One numbered service card in the services grid. */
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import type { ServiceCard as ServiceCardData } from "@/data/homepage.ts";

type Props = ServiceCardData & {
  /** Set to `false` to skip rendering this component. */
  render?: boolean;
};

const {
  render = true,
  number,
  titleLead,
  titleAccent,
  body,
  items,
  cta,
} = Astro.props;
---

{
  render && titleAccent && (
    <article class="service-card_wrap glass">
      <span class="service-card_num">{number}</span>
      <Heading tag="h3" variant="h5" class="service-card_title">
        {titleLead}
        <span class="service-card_accent">{titleAccent}</span>
      </Heading>
      <Paragraph variant="small" class="service-card_text">
        {body}
      </Paragraph>
      <ul class="service-card_list" role="list">
        {items.map((item) => (
          <li class="service-card_item">{item}</li>
        ))}
      </ul>
      {cta && (
        <a class="service-card_cta" href={cta.href}>
          {cta.label}
        </a>
      )}
    </article>
  )
}

<style is:global>
  @layer components {
    .service-card_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-7) var(--space-6);
      background-color: var(--glass-fill);
    }

    .service-card_num {
      font-family: var(--primary-family);
      font-size: var(--text-small);
      letter-spacing: var(--letter-spacing-normal);
      text-transform: uppercase;
      color: var(--ink-brand-muted);
    }

    .service-card_accent {
      color: var(--heading-accent);
    }

    .service-card_text {
      color: var(--text-muted);
    }

    .service-card_list {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      margin: 0;
      padding: 0;
      list-style: none;
      font-family: var(--secondary-family);
      font-size: var(--text-small);
      font-weight: 300;
      line-height: var(--line-height-huge);
      color: var(--text-muted);
    }

    .service-card_cta {
      margin-top: auto;
      font-family: var(--primary-family);
      font-size: var(--text-small);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--ink-brand-soft);
      transition: color 200ms;

      @media (hover: hover) {
        &:hover {
          color: var(--brand-500);
        }
      }
    }
  }
</style>
